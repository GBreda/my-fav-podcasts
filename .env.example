# Valores só para rodar nesta máquina. Troque os dois antes de publicar.
POSTGRES_PASSWORD=fila
JWT_SECRET=dev-only-secret-change-me-please-32bytes-long

# Endereço público da interface. O link de redefinir senha usa este valor.
# APP_PUBLIC_BASE_URL=http://localhost:3000
# APP_MAIL_FROM=fila@localhost

# SMTP opcional. Sem SPRING_MAIL_HOST, o link sai no log da API.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
